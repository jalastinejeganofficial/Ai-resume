# ======================================================
# AI Resume Analyzer - Environment Configuration
# ======================================================
# Works on ANY PC (even old laptops with 2GB RAM!)
# ======================================================

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/resume_analyzer

# JWT Configuration
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Configuration
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ======================================================
# AI Configuration (Choose ONE - all optional)
# ======================================================

# Option 1: OpenRouter FREE API (Recommended for old PCs)
# Get FREE key: https://openrouter.ai/ (100 requests/day FREE)
OPENROUTER_API_KEY=sk-or-your-free-key-here

# Option 2: HuggingFace FREE API
# Get FREE token: https://huggingface.co/settings/tokens
HUGGINGFACE_TOKEN=hf_your-free-token-here

# Option 3: OpenAI API (Optional, paid)
# OPENAI_API_KEY=sk-your-key-here

# AI Mode: "auto" (recommended), "local", "cloud", "hybrid"
# - auto: Automatically picks best method based on your PC
# - local: Use only local models (needs 8GB+ RAM)
# - cloud: Use cloud API only (works on any PC)
# - hybrid: Local + cloud fallback
AI_MODE=auto

# Performance Settings
# Set to true for ultra-fast analysis (<1 second, no AI)
FAST_MODE=false

# Rate Limiting (protects your system)
RATE_LIMIT_UPLOAD=10/minute
RATE_LIMIT_ANALYSIS=5/minute
RATE_LIMIT_READ=30/minute
RATE_LIMIT_GENERAL=100/minute

# Application Settings
DEBUG=True
